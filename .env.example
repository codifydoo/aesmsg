# aesmsg backend configuration.
#
# The WEB app (apps/web) needs NO environment — it is a static marketing/bouncer site with no
# crypto, no database, and no API routes. Only the backend services read env:
#
#   - apps/api    (Fastify message API)  -> see apps/api/.env.example    (authoritative)
#   - apps/worker (expiry sweeper)        -> see apps/worker/.env.example (authoritative)
#
# This file is a top-level summary of the production backend env. The per-app .env.example files
# above are the source of truth; keep them in sync.

# ---- apps/api (Fastify) ----------------------------------------------------------------------
# In production the API FAILS CLOSED at boot if DATABASE_URL, REDIS_URL, or a >= 32-byte
# RATE_LIMIT_IP_SALT is missing (rather than silently running on in-memory stores that lose every
# link on restart, or logging reversible client IPs). /api/health is store-free and stays green
# regardless — verify the env, not just the health check.

NODE_ENV=production

# Postgres for ciphertext + link metadata. Tables are created by `pnpm migrate` (run once per
# deploy, before the API/worker start).
DATABASE_URL=postgres://user:password@host:5432/aesmsg

# Redis for rate limiting.
REDIS_URL=redis://host:6379/0

# Secret HMAC salt for hashing client IPs in rate-limit keys. REQUIRED (>= 32 bytes) in prod so a
# scraped Redis store can't be reversed to raw IPs. Generate one with `openssl rand -hex 32`.
RATE_LIMIT_IP_SALT=replace-with-a-32-byte-random-secret

# Origin used to build the /l/:id links returned by POST /api/messages — the WEB host, not the
# API host.
AESMSG_PUBLIC_LINK_ORIGIN=https://aesmsg.com

# Global retention ceiling in ms (roadmap 2.5). A create whose lifetime (expiresAt - now) exceeds
# this is REJECTED with 400 (not clamped — the expiry is AAD-bound). Bounds ciphertext retention so
# no link outlives the ceiling; applies to everyone (Pro is client-side only — SEC-6). Unset/invalid
# => 365-day default. Keep >= the client's longest lifetime (365 days). Default 31536000000 (365d).
# AESMSG_MAX_RETENTION_MS=31536000000

# How much of the X-Forwarded-For chain to trust when deriving the client IP for the rate limiter.
# The per-IP limiter is the ONLY abuse control, so proxy trust is opt-in and must match your
# topology. Behind a single same-host nginx (the production layout) set this to 1.
AESMSG_TRUST_PROXY=1

# Bearer token gating GET /metrics (aggregate ops metrics; no id/IP/ciphertext). UNSET => /metrics
# is disabled (404). Set to enable scraping, and keep the path internal-only. See docs/ops-runbook.md.
# AESMSG_METRICS_TOKEN=replace-with-a-32-byte-random-secret

# ---- apps/worker (expiry sweeper) ------------------------------------------------------------
# Needs ONLY DATABASE_URL (same as above). It refuses to start without it. No Redis, no ports.
# Optional cadence override (default 900000 ms = 15 min):
# AESMSG_EXPIRY_SWEEP_INTERVAL_MS=900000
