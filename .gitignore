# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Expo CNG native projects + caches — regenerated by `expo prebuild`, never committed
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.expo/

# Test output
coverage/
.nyc_output/
__screenshots__/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# Env files (NEVER commit)
.env
.env.local
.env.*.local

# Google Play service-account key for EAS Submit (Android) — NEVER commit.
# This JSON grants release/API access to the Play Console; treat it like a private key.
# Scoped patterns (NOT a blanket *.json, which would also ignore package.json/eas.json/etc.).
play-service-account.json
*play-service-account*.json
*-service-account.json
google-service-account*.json

# Misc
.cache/
.turbo/

# Python virtualenvs (e.g. interop fixture regeneration)
.venv/
venv/

# Claude Code worktrees (ephemeral, per-session)
.claude/worktrees/

# Expo / React Native native build artifacts (regenerated by `expo prebuild`; never committed —
# the mobile app is Expo-managed JS/TS + app.config.ts, and the native projects are CNG outputs)
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/
