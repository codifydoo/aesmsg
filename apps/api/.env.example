# Fastify listen port (kept off 3000 so the web dev server can run alongside it).
PORT=4000

# When BOTH are set, the API uses Postgres + Redis; otherwise it falls back to in-memory stores.
# Local dev (see docker-compose.yml — non-default host ports):
# DATABASE_URL=postgres://aesmsg:aesmsg@localhost:55432/aesmsg
# REDIS_URL=redis://localhost:56379/0

# Origin used to build the /l/:id links returned by POST /api/messages (the WEB host, not the API).
AESMSG_PUBLIC_LINK_ORIGIN=https://aesmsg.com

# Browser origin allowed to call this API cross-origin (the messaging web client, app.aesmsg.com).
# Single-origin CORS allowlist: exactly this origin gets Access-Control-Allow-Origin; every other
# browser origin is denied (no CORS headers). Non-browser callers (native app, curl) are unaffected.
# Soft config with a sensible default; dev sets it to the local webapp origin.
AESMSG_WEBAPP_ORIGIN=https://app.aesmsg.com
# Dev: AESMSG_WEBAPP_ORIGIN=http://localhost:3001

# Global retention ceiling in milliseconds (roadmap 2.5). A create whose lifetime (expiresAt - now)
# exceeds this is REJECTED with 400 — not clamped (the expiry is bound into the message's HPKE AAD,
# so the server cannot alter it without breaking decryption). This bounds ciphertext retention and
# stops free "keep forever" links from turning the zero-knowledge backend into a permanent blob host;
# it applies to EVERYONE (Pro is client-side only, no server exemption — SEC-6). Soft config: unset or
# invalid falls back to the 365-day default. Keep this >= the client's longest offered lifetime
# (365 days) or that option would start getting rejected. Default: 31536000000 (365 days).
# AESMSG_MAX_RETENTION_MS=31536000000

# HMAC salt for rate-limit IP keys. REQUIRED (>= 32 bytes) when NODE_ENV=production — the process
# refuses to hash client IPs without it. Leave unset in dev/test.
# NOTE: the root `api:prod` npm script is a LOCAL prod-mode smoke recipe (its RATE_LIMIT_IP_SALT
# value is a throwaway), NOT a deployment config.
# RATE_LIMIT_IP_SALT=

# How much of the X-Forwarded-For chain to trust when deriving the client IP for rate limiting.
# The per-IP rate limiter is the ONLY abuse control, so proxy trust is OPT-IN and must match your
# actual topology — an over-broad value lets clients forge X-Forwarded-For and bypass the limiter.
#   unset / false        -> trust nothing; use the raw socket address (dev / direct exposure)
#   1                    -> trust ONE proxy hop (REQUIRED in production behind a single nginx)
#   <n>                  -> trust N hops
#   <ip/cidr,...>        -> trust these proxy addresses (proxy-addr syntax)
# Production runs as a container behind one same-host nginx, so the prod operator MUST set:
# AESMSG_TRUST_PROXY=1

# Bearer token that gates GET /metrics (aggregate ops metrics — request/error/rate-limit counts +
# storage volume; never any id/IP/ciphertext). UNSET => /metrics returns 404 (disabled). Set to a
# high-entropy value (openssl rand -hex 32) to enable scraping, and keep the path off the public
# vhost. See docs/ops-runbook.md.
# AESMSG_METRICS_TOKEN=
