# Local development against the docker-compose Postgres + Redis (`pnpm db:up`).
# Copy to `.env.local` (gitignored) if you want to source these into your shell.
# The pnpm scripts (`test:integration`, `web:prod`) already inline these URLs,
# so copying is optional — this file is documentation of the local endpoints.
# Host ports are non-default (55432 / 56379) so the stack coexists with other
# local Postgres/Redis instances.

# App production-mode switch (used by `pnpm web:prod`):
NODE_ENV=production
DATABASE_URL=postgres://aesmsg:aesmsg@localhost:55432/aesmsg
REDIS_URL=redis://localhost:56379/0

# Integration test gating (used by `pnpm test:integration`):
TEST_DATABASE_URL=postgres://aesmsg:aesmsg@localhost:55432/aesmsg
TEST_REDIS_URL=redis://localhost:56379/0

# Salt for hashing client IPs in rate-limit keys. Optional in local dev (an empty salt is allowed
# when NODE_ENV != production), but REQUIRED once NODE_ENV=production above — hash-ip.ts then
# refuses to start without a >= 32-byte value.
# RATE_LIMIT_IP_SALT=local-dev-only-not-a-real-secret-000000
